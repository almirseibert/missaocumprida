# URL do backend (use o IP da sua máquina na rede local, não localhost)
# Para descobrir o IP: ipconfig (Windows) ou ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.1.100:3333

# Base do site (frontend) para abrir Termos/Privacidade a partir do app
EXPO_PUBLIC_WEB_URL=https://missaocumprida-front.oehpg2.easypanel.host

# RevenueCat (Google Play Billing) — chave PÚBLICA do SDK Android (começa com "goog_")
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Identificador do entitlement configurado no painel da RevenueCat (padrão: pro)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=pro
